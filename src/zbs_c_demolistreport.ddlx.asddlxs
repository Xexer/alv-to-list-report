  } ]
  @UI.selectionField: [ {
    position: 30 
  } ]
  DocType;
  
  @EndUserText.label: 'DocDescription'
  @UI.identification: [ {
    position: 40 , 
    label: 'DocDescription'
  } ]
  @UI.lineItem: [ {
    position: 40 , 
    label: 'DocDescription'
  } ]
  DocDescription;
  
  @EndUserText.label: 'Amount'
  @UI.identification: [ {
    position: 50 , 
    label: 'Amount'
  } ]
  @UI.lineItem: [ {
    position: 50 , 
    label: 'Amount'
  } ]
