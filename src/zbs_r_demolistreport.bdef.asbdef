managed implementation in class ZBP_BS_DEMO_LIST unique;
strict ( 2 );
with draft;
extensible;

define behavior for ZBS_R_DemoListReport alias ListReport
persistent table zbs_demo_list
extensible
draft table zbs_demo_listd
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master ( global )
{
  field ( mandatory : create )
  KeyValue;

  field ( readonly )
  LocalCreatedBy,
  LocalCreatedAt,
  LocalLastChangedBy,
  LocalLastChangedAt,
  LastChangedAt;

  field ( readonly : update )
  KeyValue;

  create;
  update;
  delete;

  static action Custom;

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  mapping for zbs_demo_list corresponding extensible
    {
      KeyValue           = KEY_VALUE;
      Description        = DESCRIPTION;
      DocType            = DOC_TYPE;
      DocDescription     = DOC_DESCRIPTION;
      Amount             = AMOUNT;
      Currency           = CURRENCY;
      SellInfo           = SELL_INFO;
      Persons            = PERSONS;
      ValidatedEntry     = validated;
      LocalCreatedBy     = LOCAL_CREATED_BY;
      LocalCreatedAt     = LOCAL_CREATED_AT;
      LocalLastChangedBy = LOCAL_LAST_CHANGED_BY;
      LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
      LastChangedAt      = LAST_CHANGED_AT;
    }

}